{
	"compilerOptions": {
		"target": "esnext",
		"lib": [
			"ESNext"
		],
		"types": [
			"node"
		],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "./dist",
		"rootDir": "./src",
		"rewriteRelativeImportExtensions": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	}
}